# Vite inlines every VITE_-prefixed value into the bundle. Nothing here is
# secret, and nothing secret may be added -- see .agents/rules/repository.md.

# Where the API lives. LEAVE THIS EMPTY.
#
# Empty means the panel requests /api/v1/... relative to whatever origin served
# the page, which is what the dev proxy and the container image both provide. A
# value pointing anywhere else is inlined into the bundle at build time and
# makes every request cross-origin -- and the central server answers no
# preflight and issues its refresh cookie SameSite=Lax, so the panel stops
# working rather than working differently.
#
# To put the API somewhere else, set API_UPSTREAM on the container instead.
# wiki/environments/env.md has the whole thing, measured.
VITE_API_BASE_URL=
