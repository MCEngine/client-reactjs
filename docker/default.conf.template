# Rendered by the base image's envsubst pass at container start, which drops the
# result into /etc/nginx/conf.d/default.conf.
#
# The API_PROXY_* values are not set by hand: 10-api-upstream.envsh derives them
# from API_UPSTREAM one step earlier in the same entrypoint, so that a scheme, a
# missing port or an IPv6 literal is worked out in one place rather than by
# whoever wrote the environment.

# Needed because proxy_pass below goes through a variable, and nginx does not
# read /etc/resolv.conf to find a resolver. DNS_RESOLVER is derived from that
# file when it is not set explicitly.
resolver ${DNS_RESOLVER} valid=10s ipv6=off;

# Five seconds, not the default thirty. A resolver that cannot answer is a
# configuration error, and thirty seconds of it reads as a hung panel rather
# than as a mistake anyone can act on.
resolver_timeout 5s;

server {
    listen       8080;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # The bundle is public by definition -- it is JavaScript every visitor
    # downloads -- but the server it talks to is not, so nothing here should be
    # framed or sniffed into something else.
    #
    # These three are repeated in every location that sets a header of its own.
    # That is nginx's rule rather than a copy-paste slip: a location declaring
    # any add_header inherits *none* from the enclosing block, so one cache
    # header in a location silently drops all the security headers for it.
    add_header X-Content-Type-Options nosniff     always;
    add_header X-Frame-Options        DENY        always;
    add_header Referrer-Policy        same-origin always;

    # Vite fingerprints every asset it emits, so those may be cached forever.
    # One Cache-Control, set here rather than with `expires`, which would emit a
    # second one and leave the pair to be merged by whoever reads them.
    location /assets/ {
        add_header X-Content-Type-Options nosniff     always;
        add_header X-Frame-Options        DENY        always;
        add_header Referrer-Policy        same-origin always;
        # No `always` on this one, unlike the three above. `always` would put a
        # one-year immutable cache on the 404 below as well -- and a browser
        # that cached that could never load the asset again if a rollback
        # restored it. Without `always` the header goes on success only.
        add_header Cache-Control "public, max-age=31536000, immutable";

        # =404 rather than a fallback: a missing fingerprinted asset means a
        # stale index.html is asking for a build that no longer exists, and
        # answering with index.html would hand the browser HTML where it
        # expects JavaScript.
        try_files $uri =404;
    }

    # index.html must never be cached: it is the file that names the current
    # fingerprints, and a cached one points at assets that have been replaced.
    location = /index.html {
        add_header X-Content-Type-Options nosniff     always;
        add_header X-Frame-Options        DENY        always;
        add_header Referrer-Policy        same-origin always;
        add_header Cache-Control "no-cache" always;
    }

    location /api/ {
        # Through a variable, deliberately. A literal `proxy_pass
        # http://server:3000;` resolves the name once, at configuration load --
        # so when the API container is replaced and gets a new address, nginx
        # keeps sending to the old one until nginx itself restarts. That failure
        # looks exactly like the API being down while the API is up. A variable
        # forces resolution per request, which is what the resolver above is for.
        set $api_upstream ${API_PROXY_ADDR};
        proxy_pass ${API_PROXY_SCHEME}://$api_upstream;

        proxy_http_version 1.1;
        # $host over plaintext, the upstream's own hostname over TLS -- a public
        # endpoint is routed by Host, and the panel's hostname means nothing to
        # it. Worked out in 10-api-upstream.envsh.
        proxy_set_header Host              ${API_PROXY_HOST};
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Only consulted when the upstream is https, and then all four matter:
        # without SNI a shared front end cannot pick the certificate, and
        # without verification the hop the TLS was for is unauthenticated. The
        # base image carries the CA bundle already.
        proxy_ssl_server_name       on;
        proxy_ssl_name              ${API_PROXY_SNI};
        proxy_ssl_verify            on;
        proxy_ssl_verify_depth      3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        # A jar upload is a large streamed body and a download is a large
        # streamed response. Buffering either to disk first adds a copy and a
        # delay for no benefit, and the service caps the upload size itself
        # against the publishing org's quota -- so nginx must not impose a
        # smaller limit of its own and turn a quota answer into a bare 413.
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_buffering         off;
        proxy_read_timeout      300s;
    }

    # React Router owns every other path, so an unknown one is the app's to
    # answer, not nginx's. Without this, a reload on /product/acme-tools is a
    # 404 from nginx rather than the page the person was looking at.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
